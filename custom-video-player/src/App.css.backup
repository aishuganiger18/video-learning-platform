import { useState } from "react";

const API = "http://localhost:5000"; 
 
const plans = [ 
  { 
    name: "Free", 
    price: "₹0", 
    limit: 1, 
    description: "1 video download per day", 
  }, 
  { 
    name: "Bronze", 
    price: "₹199", 
    limit: 5, 
    description: "5 video downloads per day", 
  }, 
  { 
    name: "Silver", 
    price: "₹399", 
    limit: 10, 
    description: "10 video downloads per day", 
  }, 
  { 
    name: "Gold", 
    price: "₹699", 
    limit: 20, 
    description: "20 video downloads per day", 
  }, 
]; 
 
const videos = [ 
  { 
    id: "intro-programming", 
    title: "Introduction to Programming", 
    description: "Learn the basics of programming and problem solving.", 
  }, 
  { 
    id: "data-structures", 
    title: "Data Structures", 
    description: "Learn arrays, stacks, queues and linked lists.", 
  }, 
  { 
    id: "algorithms", 
    title: "Algorithms", 
    description: "Understand sorting, searching and basic algorithms.", 
  }, 
  { 
    id: "database", 
    title: "Database Management", 
    description: "Learn the fundamentals of databases and MongoDB.", 
  }, 
  { 
    id: "web-development", 
    title: "Web Development", 
    description: "Learn frontend and backend web development.", 
  }, 
  { 
    id: "react-basics", 
    title: "React Basics", 
    description: "Build interactive web applications using React.", 
  }, 
]; 
 
function App() { 
  const [selectedPlan, setSelectedPlan] = useState("Free"); 
  const [downloads, setDownloads] = useState(0); 
  const [remaining, setRemaining] = useState(1); 
  const [message, setMessage] = useState(""); 
 
  const userId = "silverFrontend"; 
 
  // Select subscription plan 
  const selectPlan = async (plan) => { 
 const downloadVideo = async (video) => { 
  try { 
    setMessage(Downloading ${video.title}...); 
 
    const response = await fetch(${API}/api/download, { 
      method: "POST", 
      headers: { 
        "Content-Type": "application/json", 
      }, 
      body: JSON.stringify({ 
        userId, 
        plan: selectedPlan, 
        videoId: video.id, 
        videoTitle: video.title, 
        fileSize: video.fileSize || 0, 
        thumbnail: video.thumbnail || "", 
      }), 
    }); 
 
    const data = await response.json(); 
 
    if (!response.ok || data.success === false) { 
      setMessage(data.message || "Download failed."); 
      return; 
    } 
 
    setDownloads( 
      data.downloads !== undefined ? data.downloads : downloads + 1 
    ); 
 
    setRemaining( 
      data.remaining !== undefined 
        ? data.remaining 
        : Math.max(remaining - 1, 0) 
    ); 
 
    setMessage(data.message || ${video.title} downloaded successfully!); 
 
  } catch (error) { 
    console.error("Download error:", error); 
    setMessage(Download failed: ${error.message}); 
  } 
}; 
  // Download video 
  const downloadVideo = async (video) => { 
    try { 
      setMessage(Downloading ${video.title}...); 
 
      const response = await fetch(${API}/api/download, { 
        method: "POST", 
        headers: { 
          "Content-Type": "application/json", 
        }, 
        body: JSON.stringify({ 
          userId, 
          plan: selectedPlan, 
          videoId: video.id, 
          videoTitle: video.title, 
        }), 
      }); 
 
      const data = await response.json(); 
 
      if (!response.ok || data.success === false) { 
        setMessage(data.message || "Download failed."); 
        return; 
      } 
 
      setDownloads(data.downloads ?? downloads + 1); 
      setRemaining( 
        data.remaining ?? 
          Math.max(remaining - 1, 0) 
      ); 
 
      setMessage(${video.title} downloaded successfully!); 
    } catch (error) { 
      setMessage("Unable to connect to the backend."); 
    } 
  }; 
 
  return ( 
    <div className="app"> 
      <header className="header"> 
        <h1>LEARNHUB</h1> 
        <p>Video Learning Platform</p> 
 
        <div className="backend-status"> 
          Backend: Video Learning Platform Backend is running! 
        </div> 
      </header> 
 
      {/* Subscription Plans */} 
      <section className="plans-section"> 
        <h2>Subscription Plans</h2> 
 
        <div className="plans-container"> 
          {plans.map((plan) => ( 
            <div 
              className={plan-card ${ 
                selectedPlan === plan.name ? "selected" : "" 
              }} 
              key={plan.name} 
            > 
              <h3>{plan.name}</h3> 
 
              <h2>{plan.price}</h2> 
 
              <p>{plan.description}</p> 
 
              <button onClick={() => selectPlan(plan)}> 
                Select {plan.name} 
              </button> 
            </div> 
          ))} 
        </div> 
      </section> 
 
      {/* Current Plan */} 
      <section className="current-plan"> 
        <h2>Your Current Plan</h2> 
 
        <div className="current-info"> 
          <div> 
            <span>Plan</span> 
            <strong>{selectedPlan}</strong> 
          </div> 
 
          <div> 
            <span>Downloads</span> 
            <strong> 
              {downloads} /{" "} 
              {plans.find((p) => p.name === selectedPlan)?.limit || 1} 
            </strong> 
          </div> 
 
          <div> 
            <span>Remaining</span> 
            <strong>{remaining}</strong> 
          </div> 
        </div> 
      </section> 
 
      {/* Message */} 
      {message && ( 
        <div className="message"> 
          {message} 
        </div> 
      )} 
 
      {/* Videos */} 
      <section className="videos-section"> 
        <h2>🎥 Available Videos</h2> 
 
        <div className="videos-container"> 
          {videos.map((video) => ( 
            <div className="video-card" key={video.id}> 
              <div className="video-icon">▶</div> 
 
              <div className="video-content"> 
                <h3>{video.title}</h3> 
 
                <p>{video.description}</p> 
 
                <div className="video-buttons"> 
                  <button className="watch-btn"> 
                    ▶ Watch Video 
                  </button> 
 
                  <button 
                    className="download-btn" 
                    onClick={() => downloadVideo(video)} 
                    disabled={remaining <= 0} 
                  > 
                    ↓ Download 
                  </button> 
                </div> 
              </div> 
            </div> 
          ))} 
        </div> 
      </section> 
    </div> 
  ); 
 
} 
 
