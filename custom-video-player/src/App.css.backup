App.css
/* LEARNHUB - complete App.css replacement */

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f5f7ff;
  background: #0b0d16;
}

* { box-sizing: border-box; }

html, body, #root {
  margin: 0;
  min-height: 100%;
}

body {
  min-width: 320px;
  background: #0b0d16;
  color: #f5f7ff;
}

button, input, select { font: inherit; }
button { border: 0; }

.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 15%, rgba(110, 65, 220, .12), transparent 35%),
    #0b0d16;
}

.topbar,
.content {
  width: min(100% - 56px, 1120px);
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px 0 16px;
}

.brand {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: .04em;
}

.subtitle {
  margin-top: 4px;
  color: #9ba0b6;
  font-size: 12px;
}

.quality {
  padding: 9px 13px;
  border: 1px solid rgba(150, 100, 255, .35);
  border-radius: 999px;
  background: rgba(72, 36, 140, .16);
  color: #c8b7ff;
  font-size: 12px;
  font-weight: 700;
}

.video-player {
  position: relative;
  overflow: hidden;
  width: 100%;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 16px;
  background: #050609;
  box-shadow: 0 25px 70px rgba(0,0,0,.35);
}

.video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: #000;
  cursor: pointer;
}

.big-play {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 10;
  width: 58px;
  height: 58px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #7b3ff2;
  color: #fff;
  font-size: 25px;
  cursor: pointer;
  box-shadow: 0 8px 30px rgba(123,63,242,.45);
}

.controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 0 12px 10px;
  background: linear-gradient(to top, rgba(0,0,0,.90), rgba(0,0,0,.45), transparent);
  transition: opacity .2s ease, transform .2s ease;
}

.controls.visible { opacity: 1; transform: translateY(0); }
.controls.hidden { opacity: 0; transform: translateY(8px); }

.timeline-area {
  position: relative;
  height: 22px;
  display: flex;
  align-items: center;
  cursor: pointer;
}

.timeline-area::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.22);
}

.buffered {
  position: absolute;
  left: 0;
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.4);
  pointer-events: none;
}

.timeline {
  position: relative;
  z-index: 4;
  width: 100%;
  height: 22px;
  margin: 0;
  appearance: none;
  background: transparent;
  cursor: pointer;
}

.timeline::-webkit-slider-runnable-track {
  height: 5px;
  background: transparent;
}

.timeline::-webkit-slider-thumb {
  width: 12px;
  height: 12px;
  margin-top: -3.5px;
  appearance: none;
  border: 2px solid #fff;
  border-radius: 50%;
  background: #a46cff;
}

.timeline::-moz-range-track {
  height: 5px;
  background: transparent;
}

.timeline::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: #a46cff;
}

/* NEW: video thumbnail preview while hovering timeline */
.timeline-preview {
  position: absolute;
  left: 0;
  bottom: 30px;
  z-index: 100;
  width: 190px;
  padding: 5px;
  transform: translateX(-50%);
  border: 1px solid rgba(255,255,255,.20);
  border-radius: 9px;
  background: rgba(8,9,15,.97);
  box-shadow: 0 12px 35px rgba(0,0,0,.65);
  pointer-events: none;
}

.timeline-preview-video {
  display: block;
  width: 180px;
  height: 102px;
  object-fit: cover;
  border-radius: 6px;
  background: #000;
}

.timeline-preview-time {
  padding-top: 5px;
  text-align: center;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
}

.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.left-controls,
.right-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}

.controls button,
.controls select {
  min-height: 30px;
  padding: 5px 9px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 6px;
  background: rgba(20,20,28,.78);
  color: #f3f3f8;
  font-size: 12px;
  cursor: pointer;
}

.controls button:hover,
.controls select:hover {
  background: rgba(60,42,90,.9);
}

.active-control {
  background: rgba(119,67,220,.8) !important;
  border-color: rgba(174,129,255,.65) !important;
}

.volume {
  width: 82px;
  accent-color: #9b63ff;
}

.time {
  color: #d6d6df;
  font-size: 11px;
  white-space: nowrap;
}

.loading {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 15;
  transform: translate(-50%,-50%);
  padding: 12px 16px;
  border-radius: 10px;
  background: rgba(0,0,0,.72);
  color: #fff;
  font-size: 13px;
}

.spinner {
  display: inline-block;
  width: 13px;
  height: 13px;
  margin-right: 8px;
  vertical-align: -2px;
  border: 2px solid rgba(255,255,255,.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.resume-message {
  position: absolute;
  left: 50%;
  top: 18px;
  z-index: 30;
  transform: translateX(-50%);
  padding: 9px 13px;
  border-radius: 8px;
  background: rgba(0,0,0,.75);
  color: #fff;
  font-size: 12px;
}

.video-info {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;
  padding: 26px 4px 22px;
}

.badge {
  display: inline-block;
  padding: 5px 8px;
  border-radius: 5px;
  background: rgba(112,57,215,.2);
  color: #bd9aff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
}

.video-info h1 {
  margin: 13px 0 7px;
  font-size: clamp(24px, 3vw, 34px);
  line-height: 1.15;
}

.video-info p {
  margin: 0;
  color: #9da1b4;
  font-size: 14px;
}

.status {
  padding-top: 10px;
  color: #a6aabd;
  font-size: 12px;
  white-space: nowrap;
}

.completed {
  padding: 8px 11px;
  border-radius: 999px;
  background: rgba(28,140,84,.14);
  color: #72e4a9;
  font-weight: 700;
}

.shortcuts,
.requirements {
  margin-top: 18px;
  padding: 20px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  background: rgba(20,21,31,.72);
}

.shortcuts h2,
.requirements h2 {
  margin: 0 0 17px;
  text-align: center;
  font-size: 16px;
}

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 10px;
}

.shortcut-grid > div,
.feature-grid > div {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 11px 13px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 8px;
  background: rgba(27,28,39,.8);
}

.shortcut-grid strong {
  padding: 4px 7px;
  border-radius: 5px;
  background: rgba(112,73,194,.13);
  color: #c9b4ff;
  font-size: 11px;
}

.shortcut-grid span {
  color: #b1b4c4;
  font-size: 11px;
  text-align: right;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 10px;
}

.feature-grid > div {
  justify-content: center;
  color: #d8d9e3;
  text-align: center;
  font-size: 11px;
}

@media (max-width: 800px) {
  .topbar, .content {
    width: min(100% - 28px, 1120px);
  }

  .volume, .time { display: none; }
  .shortcut-grid { grid-template-columns: 1fr; }
  .feature-grid { grid-template-columns: repeat(2,1fr); }
  .video-info { flex-direction: column; gap: 8px; }
  .status { padding-top: 0; }
}

@media (max-width: 520px) {
  .controls button, .controls select {
    min-height: 28px;
    padding: 4px 6px;
    font-size: 10px;
  }

  .timeline-preview { width: 150px; }
  .timeline-preview-video {
    width: 140px;
    height: 80px;
  }

  .feature-grid { grid-template-columns: 1fr; }
  .shortcuts, .requirements { padding: 14px; }
}
